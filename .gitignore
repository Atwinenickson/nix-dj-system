# ============================================================
# DJ System — Full .gitignore
# ============================================================

# ------------------------------------------------------------
# Python / Backend
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.env/
.python-version

# FastAPI / Uvicorn
*.pid
*.log
uvicorn.log

# Local DB — never commit music metadata or history
backend/dj.db
backend/dj.db-journal
backend/dj.db-wal
backend/dj.db-shm
*.sqlite
*.sqlite3
*.db
*.db-journal

# ------------------------------------------------------------
# Music files — NEVER commit audio/video to git
# ------------------------------------------------------------
backend/songs/
*.mp3
*.m4a
*.aac
*.flac
*.wav
*.ogg
*.oga
*.opus
*.wma
*.aiff
*.aif
*.alac
*.mp4
*.m4v
*.mov
*.webm
*.mkv
*.avi

backend/songs/*
backend/songs*
# ------------------------------------------------------------
# Node / Frontend
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Vite build output & cache
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/
*.local

# Vue / Vite build info
frontend/stats.html
frontend/stats.json

# Coverage / test artifacts
coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------
# Environment files
# ------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# But keep the example
!.env.example

# ------------------------------------------------------------
# Editor / IDE
# ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.history/

# ------------------------------------------------------------
# OS / macOS junk
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------
# Don't commit local overrides
docker-compose.override.yml

# ------------------------------------------------------------
# Testing / coverage
# ------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
*.bak
*.orig
*.tmp
.cache/
tmp/
temp/